<!DOCTYPE html>
<html>
  <head>
    <title>Cool Hacking Thing</title>
    <link rel="stylesheet" href="styles.css" />
  </head>
<div class="game-text">
  Supa Sigma Hacking App
</div>

<div class="button-layer">
  <button class="hacking-btn" onclick="
    let answer1 = prompt('You have begun hacking. The AI will ask you questions. Answer correctly to continue. Type 1 to continue hacking.');
    if (answer1) {
      let answer2 = prompt('What is used to pick up beakers?'); 
      if (answer2 === 'Beaker Tongs') { 
        alert('Level 1 bypassed.');
        let answer3 = prompt('What is the highest level shape in HHPS?'); 
        if (answer3 === 'Octagon') {
          alert('Level 2 Firewall bypassed.');
          let answer4 = prompt('Should you wear big sweaters in the lab?');
          if (answer4 === 'No') {
            alert('Firewall Terminated. Your code is 1234');
          } else { alert('Alert! Connection terminated.'); }
        } else { alert('Alert! Connection terminated.'); }
      } else { alert('Alert! Connection terminated.'); }
    }
  ">
    Start Hacking
  </button>
</div>


</html>
